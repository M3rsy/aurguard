# Example only. Update source URL, checksums and maintainer metadata before AUR publication.
pkgname=aurguard
pkgver=0.1.0
pkgrel=1
pkgdesc='Static security scanner for Arch User Repository packages'
arch=('x86_64')
url='https://github.com/M3rsy/aurguard'
license=('MIT')
depends=('git')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('REPLACE_WITH_RELEASE_SHA256')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked -p aurguard
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --locked --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/aurguard "$pkgdir/usr/bin/aurguard"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
